strict-peer-deps=false ; Allow installation when peerDependencies are conflicting.
engine-strict=true     ; Require current node/npm versions to match the "engines" field in package.json.
package-lock=true      ; Always use and update package-lock.json.
save-exact=true        ; Always save exact versions in package.json (without ^ or ~).
progress=false         ; Disable progress bar during installation.
allow-git=root         ; Allow git dependencies declared directly in package.json (e.g. @monadiam/shared).
loglevel=warn          ; Logging level: silent | error | warn | notice | http | timing | info | verbose | silly.
audit=true             ; Enable automatic npm audit after installation.
fund=false             ; Disable sponsorship/funding messages from packages.
color=true             ; Enable colored terminal output.
