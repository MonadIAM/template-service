# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

SERVICE_NAME="template-service"
NODE_ENV="development"
API_VERSION="1"

APP_BASE_IMAGE="node:24.18.0-alpine3.24"
APP_HOST="0.0.0.0"
APP_PORT="5003"
THROTTLE_LIMIT="20"
THROTTLE_TTL="1m"
HSTS_MAX_AGE="1y"
BODY_LIMIT_BYTES="5242880"
JWT_ISSUER="identity-service"
JWT_JWKS_URL="http://identity-service:5001/api/v1/.well-known/jwks.json"
JWT_JWKS_COOLDOWN_DURATION="30s"
JWT_JWKS_TIMEOUT_DURATION="5s"
JWT_JWKS_CACHE_MAX_AGE="10m"
IDENTITY_SERVICE_URL="http://localhost:5001"
ACCESS_CONTROL_SERVICE_URL="http://localhost:5002"
ACCESS_CONTROL_GRPC_URL="access-control-service:50051"
ALLOWED_SERVICE_ORIGINS='["http://localhost:5001","http://localhost:5002","http://localhost:5003"]'
ALLOWED_UI_ORIGINS='[]'

# ---------------------------------------------------------------------------
# PostgreSQL - common
# ---------------------------------------------------------------------------

POSTGRES_IMAGE="postgres:17.2-alpine3.21"
POSTGRES_DB="template-service"
POSTGRES_USER="user"
POSTGRES_HOST="postgresql-primary"
POSTGRES_PORT="5432"
POSTGRES_PRIMARY_PUBLISHED_PORT="6031"
POSTGRES_REPLICA_PUBLISHED_PORT="6032"
POSTGRES_SSL="false"
POSTGRES_SSL_REJECT_UNAUTHORIZED="false"
POSTGRES_POOL_MAX="2"
POSTGRES_POOL_IDLE_MS="30s"
POSTGRES_LOGGING="true"
POSTGRES_CQRS_ENABLED="true"

# ---------------------------------------------------------------------------
# PostgreSQL - write-side
# ---------------------------------------------------------------------------

POSTGRES_WRITE_POOL_MAX="2"
POSTGRES_WRITE_POOL_IDLE_MS="30s"
POSTGRES_WRITE_HOST="postgresql-primary"

# ---------------------------------------------------------------------------
# PostgreSQL - read-side
# ---------------------------------------------------------------------------

POSTGRES_READ_POOL_MAX="4"
POSTGRES_READ_POOL_IDLE_MS="30s"
POSTGRES_READ_HOST="postgresql-replica"

# ---------------------------------------------------------------------------
# PostgreSQL - replication
# ---------------------------------------------------------------------------

POSTGRES_REPLICATION_USER="repl_user"
POSTGRES_REPLICATION_SLOT="template_service_replica_1"

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

REDIS_IMAGE="redis:7.4.2-alpine3.21"
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_PUBLISHED_PORT="7031"
REDIS_DB_CACHE="0"
REDIS_DB_LIMITER="1"
REDIS_DB_QUEUE="2"

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------

KAFKA_BROKER="kafka:29092"
KAFKA_RETRY_ATTEMPTS="10"
KAFKA_RETRY_INITIAL_TIME="300ms"
KAFKA_CONNECT_IMAGE="quay.io/debezium/connect:3.0"
KAFKA_CONNECT_PORT="8084"
KAFKAJS_NO_PARTITIONER_WARNING="1"
KAFKA_DLQ_MAX_RETRIES="5"
KAFKA_DLQ_RETRY_BASE_DELAY="5s"
KAFKA_DLQ_RETRY_JITTER="1s"

# ---------------------------------------------------------------------------
# BullMQ - cleanup
# ---------------------------------------------------------------------------

AUDIT_LOG_RETENTION_TTL="35d"
CHANGE_LOG_RETENTION_TTL="35d"
CLEANUP_BATCH_BACKOFF_DELAY="10s"
CLEANUP_BATCH_DELAY="5s"
CLEANUP_BATCH_ATTEMPTS="3"
CLEANUP_BATCH_SIZE="100"

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

DOCKER_NETWORK_MONITORING="monitoring-network"
DOCKER_NETWORK_KAFKA="kafka-net"
DOCKER_NETWORK_VAULT="vault-net"

# ---------------------------------------------------------------------------
# Debezium
# ---------------------------------------------------------------------------

DEBEZIUM_INIT_IMAGE="alpine:3.21"

# ---------------------------------------------------------------------------
# Vault
# ---------------------------------------------------------------------------

VAULT_IMAGE="hashicorp/vault:1.21.3"
VAULT_PORT="8200"
VAULT_ROOT_TOKEN="root"

VAULT_KV_MOUNT="kv"
VAULT_KV_RUNTIME_PATH="template-service/runtime"
VAULT_KV_REPLICATION_PATH="infrastructure/postgresql-replication"

# ---------------------------------------------------------------------------
# Cache TTLs
# ---------------------------------------------------------------------------

ACCESS_CACHE_TTL="1m"
REAUTHENTICATION_TTL="5m"
